NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://localhost:5432/dadia_transport

REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# SMS
SMS_PROVIDER=none
TELNYX_API_KEY=
TELNYX_MESSAGING_PROFILE_ID=
TELNYX_FROM_NUMBER=

# ============================================================
# DADIA MULTI-COUNTRY OTP SMS
# One SMS provider can be configured independently per country.
# Do NOT put these values in Flutter or in the Android app.
# ============================================================

SMS_PROVIDER_IR=http-json
SMS_PROVIDER_AM=http-json
SMS_PROVIDER_AZ=http-json
SMS_PROVIDER_TR=http-json
SMS_PROVIDER_AE=http-json
SMS_PROVIDER_IQ=http-json

SMS_API_URL_IR=
SMS_API_KEY_IR=
SMS_API_KEY_HEADER_IR=Authorization
SMS_API_KEY_PREFIX_IR=Bearer
SMS_MESSAGE_TEMPLATE_IR=DADIA verification code: {code}
SMS_BODY_TEMPLATE_IR={"to":"{phone}","message":"{message}"}

SMS_API_URL_AM=
SMS_API_KEY_AM=
SMS_API_KEY_HEADER_AM=Authorization
SMS_API_KEY_PREFIX_AM=Bearer
SMS_MESSAGE_TEMPLATE_AM=DADIA verification code: {code}
SMS_BODY_TEMPLATE_AM={"to":"{phone}","message":"{message}"}

SMS_API_URL_AZ=
SMS_API_KEY_AZ=
SMS_API_KEY_HEADER_AZ=X-API-Key
SMS_API_KEY_PREFIX_AZ=
SMS_MESSAGE_TEMPLATE_AZ=DADIA verification code: {code}
SMS_BODY_TEMPLATE_AZ={"to":"{phone}","text":"{message}"}

SMS_API_URL_TR=
SMS_API_KEY_TR=
SMS_API_KEY_HEADER_TR=Authorization
SMS_API_KEY_PREFIX_TR=Bearer
SMS_MESSAGE_TEMPLATE_TR=DADIA verification code: {code}
SMS_BODY_TEMPLATE_TR={"to":"{phone}","message":"{message}"}

SMS_API_URL_AE=
SMS_API_KEY_AE=
SMS_API_KEY_HEADER_AE=Authorization
SMS_API_KEY_PREFIX_AE=Bearer
SMS_MESSAGE_TEMPLATE_AE=DADIA verification code: {code}
SMS_BODY_TEMPLATE_AE={"to":"{phone}","message":"{message}"}

SMS_API_URL_IQ=
SMS_API_KEY_IQ=
SMS_API_KEY_HEADER_IQ=Authorization
SMS_API_KEY_PREFIX_IQ=Bearer
SMS_MESSAGE_TEMPLATE_IQ=DADIA verification code: {code}
SMS_BODY_TEMPLATE_IQ={"to":"{phone}","message":"{message}"}
